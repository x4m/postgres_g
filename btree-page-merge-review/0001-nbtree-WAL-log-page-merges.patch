+				END_CRIT_SECTION();
 
 				right_anchor = BufferGetBlockNumber(bwd_buf);
 				bwd_blkno = bwd_opaque->btpo_prev;
@@ -1728,6 +1748,22 @@ backtrack:
 			opaque->btpo_flags |= BTP_HALF_DEAD;
 			MarkBufferDirty(buf);
 
+			if (RelationNeedsWAL(rel))
+			{
+				xl_btree_merge xlrec;
+				XLogRecPtr	recptr;
