index b9ea0696fd..e1b0c49944 100644
--- a/src/backend/access/nbtree/nbtmerge.c
+++ b/src/backend/access/nbtree/nbtmerge.c
@@ -18,7 +18,9 @@
 #include "postgres.h"
 
 #include "access/nbtree.h"
+#include "access/nbtxlog.h"
 #include "access/tableam.h"
+#include "access/xloginsert.h"
 #include "common/int.h"
 #include "storage/bufmgr.h"
 #include "storage/lmgr.h"
@@ -313,6 +315,7 @@ _bt_mergepage(BTMergeState mstate)
 	Size	   *r_sizes = NULL;
 	BTPageOpaqueData saved_opaque;
 	FullTransactionId safemergexid;
+	XLogRecPtr	recptr;
 	bool		merged = false;
 
 	parent_blkno = stack->bts_blkno;
@@ -418,8 +421,9 @@ _bt_mergepage(BTMergeState mstate)
 	 * absorbs all tuples, parent loses R's downlink) would leave the index in
 	 * an inconsistent state.  Perform all three modifications as an atomic
 	 * unit inside a critical section so that any error panics the server
-	 * rather than aborting with a partially updated index.  WAL logging will
-	 * be added here once the redo infrastructure is in place.
+	 * rather than aborting with a partially updated index.  One WAL record
+	 * covers all three buffers, so redo cannot observe only part of the
+	 * merge.
 	 */
 	START_CRIT_SECTION();
 
@@ -469,6 +473,29 @@ _bt_mergepage(BTMergeState mstate)
 	MarkBufferDirty(right_buf);
 	MarkBufferDirty(parent_buf);
 
+	if (RelationNeedsWAL(rel))
+	{
+		xl_btree_merge xlrec;
+
+		xlrec.action = XLOG_BTREE_MERGE_PAGES;
+
+		XLogBeginInsert();
+		XLogRegisterData(&xlrec, SizeOfBtreeMerge);
+		XLogRegisterBuffer(0, left_buf,
+						   REGBUF_STANDARD | REGBUF_FORCE_IMAGE);
+		XLogRegisterBuffer(1, right_buf,
+						   REGBUF_STANDARD | REGBUF_FORCE_IMAGE);
+		XLogRegisterBuffer(2, parent_buf,
+						   REGBUF_STANDARD | REGBUF_FORCE_IMAGE);
+		recptr = XLogInsert(RM_BTREE_ID, XLOG_BTREE_MERGE);
+	}
+	else
+		recptr = XLogGetFakeLSN(rel);
+
+	PageSetLSN(left_page, recptr);
+	PageSetLSN(right_page, recptr);
+	PageSetLSN(parent_page, recptr);
+
 	END_CRIT_SECTION();
 
 	/* Free temporary memory. */
