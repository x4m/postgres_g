 		/*
 		 * Apply any needed deletes or updates.  We issue just one
diff --git a/src/backend/access/nbtree/nbtxlog.c b/src/backend/access/nbtree/nbtxlog.c
index dff7d286fc..ef8c9859c4 100644
--- a/src/backend/access/nbtree/nbtxlog.c
+++ b/src/backend/access/nbtree/nbtxlog.c
@@ -1000,6 +1000,51 @@ btree_xlog_reuse_page(XLogReaderState *record)
 												   xlrec->locator);
 }
 
+/*
+ * Replay a page merge or one step of merge-group cleanup.
+ *
+ * Every registered block is required to carry a full-page image.  Restoring
+ * those images is sufficient redo; XLogReadBufferForRedo() also handles the
+ * usual page-LSN check and marks restored buffers dirty.
+ */
+static void
+btree_xlog_merge(XLogReaderState *record)
+{
+	xl_btree_merge *xlrec = (xl_btree_merge *) XLogRecGetData(record);
+	int			nblocks;
+
+	switch (xlrec->action)
+	{
+		case XLOG_BTREE_MERGE_PAGES:
+			nblocks = 3;
+			break;
+		case XLOG_BTREE_MERGE_CLEAR_PAGE:
+		case XLOG_BTREE_MERGE_MARK_HALFDEAD:
+			nblocks = 1;
+			break;
+		default:
+			elog(PANIC, "btree_xlog_merge: unknown action %u",
+				 xlrec->action);
+	}
+
+	for (int block_id = 0; block_id < nblocks; block_id++)
+	{
+		Buffer		buf = InvalidBuffer;
+		XLogRedoAction action;
+
+		if (!XLogRecHasBlockRef(record, block_id))
+			elog(PANIC, "btree_xlog_merge: missing block reference %d",
+				 block_id);
+
+		action = XLogReadBufferForRedo(record, block_id, &buf);
+		if (action == BLK_NEEDS_REDO)
+			elog(PANIC, "btree_xlog_merge: block %d has no full-page image",
+				 block_id);
+		if (BufferIsValid(buf))
+			UnlockReleaseBuffer(buf);
+	}
+}
+
 void
 btree_redo(XLogReaderState *record)
 {
@@ -1052,6 +1097,9 @@ btree_redo(XLogReaderState *record)
 		case XLOG_BTREE_META_CLEANUP:
 			_bt_restore_meta(record, 0);
 			break;
+		case XLOG_BTREE_MERGE:
+			btree_xlog_merge(record);
+			break;
 		default:
 			elog(PANIC, "btree_redo: unknown op code %u", info);
 	}
diff --git a/src/backend/access/rmgrdesc/nbtdesc.c b/src/backend/access/rmgrdesc/nbtdesc.c
index 1d08f9957b..5ba3a5243a 100644
--- a/src/backend/access/rmgrdesc/nbtdesc.c
+++ b/src/backend/access/rmgrdesc/nbtdesc.c
@@ -132,6 +132,27 @@ btree_desc(StringInfo buf, XLogReaderState *record)
 								 xlrec->last_cleanup_num_delpages);
 				break;
 			}
+		case XLOG_BTREE_MERGE:
+			{
+				xl_btree_merge *xlrec = (xl_btree_merge *) rec;
+
+				switch (xlrec->action)
+				{
+					case XLOG_BTREE_MERGE_PAGES:
+						appendStringInfoString(buf, "merge pages");
+						break;
+					case XLOG_BTREE_MERGE_CLEAR_PAGE:
+						appendStringInfoString(buf, "clear merged page");
+						break;
+					case XLOG_BTREE_MERGE_MARK_HALFDEAD:
+						appendStringInfoString(buf, "mark merged-away page half-dead");
+						break;
+					default:
+						appendStringInfo(buf, "unknown action %u", xlrec->action);
+						break;
+				}
+				break;
+			}
 	}
 }
 
@@ -187,6 +208,9 @@ btree_identify(uint8 info)
 		case XLOG_BTREE_META_CLEANUP:
 			id = "META_CLEANUP";
 			break;
+		case XLOG_BTREE_MERGE:
+			id = "MERGE";
+			break;
 	}
 
 	return id;
diff --git a/src/include/access/nbtxlog.h b/src/include/access/nbtxlog.h
index 3a78ec27fe..61b2af1cc3 100644
--- a/src/include/access/nbtxlog.h
+++ b/src/include/access/nbtxlog.h
@@ -42,6 +42,32 @@
 										 * FSM */
 #define XLOG_BTREE_META_CLEANUP	0xE0	/* update cleanup-related data in the
 										 * metapage */
+#define XLOG_BTREE_MERGE		0xF0	/* merge pages or advance merge
+										 * cleanup */
+
+typedef enum xl_btree_merge_action
+{
+	XLOG_BTREE_MERGE_PAGES,
+	XLOG_BTREE_MERGE_CLEAR_PAGE,
+	XLOG_BTREE_MERGE_MARK_HALFDEAD,
+}			xl_btree_merge_action;
+
+/*
+ * Page merge WAL records currently force a full-page image for every
+ * registered buffer.  This deliberately simple representation makes the
+ * three-page merge atomic with respect to WAL replay.  It can be replaced by
+ * a compact logical representation once the on-page design has settled.
+ *
+ * MERGE_PAGES:        blocks 0, 1, 2 are L, R, and parent
+ * MERGE_CLEAR_PAGE:   block 0 is one M page
+ * MERGE_MARK_HALFDEAD: block 0 is the MA page
+ */
+typedef struct xl_btree_merge
+{
+	uint8		action;
+}			xl_btree_merge;
+
+#define SizeOfBtreeMerge (offsetof(xl_btree_merge, action) + sizeof(uint8))
 
 /*
  * All that we need to regenerate the meta-data page
