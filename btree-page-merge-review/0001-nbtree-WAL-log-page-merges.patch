 src/backend/access/nbtree/nbtree.c    | 39 +++++++++++++++++++++-
 src/backend/access/nbtree/nbtxlog.c   | 48 +++++++++++++++++++++++++++
 src/backend/access/rmgrdesc/nbtdesc.c | 24 ++++++++++++++
 src/include/access/nbtxlog.h          | 26 +++++++++++++++
 5 files changed, 165 insertions(+), 3 deletions(-)

