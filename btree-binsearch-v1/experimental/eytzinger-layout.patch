+/*
+ * Place tuple bodies in breadth-first binary-search order, without changing
+ * their logical order in the line pointer array.
+ */
+static void
+_bt_eytzinger_page(Page page)
+{
+	BTPageOpaque opaque = BTPageGetOpaque(page);
+	OffsetNumber first = P_FIRSTDATAKEY(opaque);
+	OffsetNumber maxoff = PageGetMaxOffsetNumber(page);
+	OffsetNumber order[MaxIndexTuplesPerPage];
+	OffsetNumber queue_low[MaxIndexTuplesPerPage];
+	OffsetNumber queue_high[MaxIndexTuplesPerPage];
+	Page		temp;
+	Offset		upper;
+	int			nitems = 0;
+	int			queue_head = 0;
+	int			queue_tail = 0;
+
+	if (!P_ISLEAF(opaque))
+		first = OffsetNumberNext(first);
+
+	if (first <= maxoff)
+	{
+		queue_low[queue_tail] = first;
+		queue_high[queue_tail++] = OffsetNumberNext(maxoff);
+	}
+
+	while (queue_head < queue_tail)
+	{
+		OffsetNumber low = queue_low[queue_head];
+		OffsetNumber high = queue_high[queue_head++];
+		OffsetNumber mid = low + (high - low) / 2;
+
+		order[nitems++] = mid;
+		if (low < mid)
+		{
+			queue_low[queue_tail] = low;
+			queue_high[queue_tail++] = mid;
+		}
+		if (OffsetNumberNext(mid) < high)
+		{
+			queue_low[queue_tail] = OffsetNumberNext(mid);
+			queue_high[queue_tail++] = high;
+		}
+	}
+
+	/* Keep non-search tuples out of the decision tree. */
+	if (!P_ISLEAF(opaque))
+		order[nitems++] = P_FIRSTDATAKEY(opaque);
+	if (!P_RIGHTMOST(opaque))
+		order[nitems++] = P_HIKEY;
+
+	Assert(nitems == maxoff);
+	temp = PageGetTempPageCopy(page);
+	upper = ((PageHeader) page)->pd_special;
+	for (int i = nitems - 1; i >= 0; i--)
+	{
+		ItemId		dest = PageGetItemId(page, order[i]);
+		ItemId		source = PageGetItemId(temp, order[i]);
+		Size		len = MAXALIGN(ItemIdGetLength(source));
+
+		upper -= len;
+		memcpy((char *) page + upper, PageGetItem(temp, source), len);
+		dest->lp_off = upper;
+	}
+	((PageHeader) page)->pd_upper = upper;
+	pfree(temp);
+}
