index 795fded49d3..895b42c8f00 100644
--- a/src/backend/access/nbtree/nbtcompare.c
+++ b/src/backend/access/nbtree/nbtcompare.c
@@ -57,8 +57,11 @@
 
 #include <limits.h>
 
