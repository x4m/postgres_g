 #ifdef HAVE_LIBZ
 	gzFile		gzfp;
@@ -294,6 +298,8 @@ dir_open_for_write(WalWriteMethod *wwmethod, const char *pathname,
 	f->base.pathname = pg_strdup(pathname);
 	f->fd = fd;
 	f->fullpath = pg_strdup(tmppath);
+	f->pad_to_size = pad_to_size;
+	f->zeroed_from = -1;
 	if (temp_suffix)
 		f->temp_suffix = pg_strdup(temp_suffix);
 
@@ -377,10 +383,66 @@ dir_write(Walfile *f, const void *buf, size_t count)
 		}
 	}
 	if (r > 0)
+	{
 		df->base.currpos += r;
+		if (df->zeroed_from >= 0)
+			df->zeroed_from = df->base.currpos;
+	}
 	return r;
 }
 
+static ssize_t
+dir_write_zeros(Walfile *f, size_t count)
+{
+	DirectoryMethodFile *df = (DirectoryMethodFile *) f;
+
+	if (f->wwmethod->compression_algorithm == PG_COMPRESSION_NONE)
+	{
+		int			rc;
+
+		clear_error(f->wwmethod);
+		rc = 0;
+		if (df->zeroed_from < 0 || df->zeroed_from > f->currpos)
+		{
+			do
+				rc = ftruncate(df->fd, f->currpos);
+			while (rc < 0 && errno == EINTR);
+			if (rc == 0)
+			{
+				do
+					rc = ftruncate(df->fd, df->pad_to_size);
+				while (rc < 0 && errno == EINTR);
+			}
+		}
+
+		if (rc < 0)
+		{
+			f->wwmethod->lasterrno = errno;
+			return -1;
+		}
+
+		if (df->zeroed_from < 0)
+			df->zeroed_from = f->currpos;
+		f->currpos += count;
+		return count;
+	}
+	else
+	{
+		PGAlignedXLogBlock zerobuf = {0};
+		size_t		remaining = count;
+
+		while (remaining > 0)
+		{
+			size_t		chunk = Min(remaining, sizeof(zerobuf.data));
+
+			if (dir_write(f, zerobuf.data, chunk) != chunk)
+				return -1;
+			remaining -= chunk;
+		}
+		return count;
+	}
+}
