@@ -683,6 +746,7 @@ static const WalWriteMethodOps WalTarMethodOps = {
 	.get_file_size = tar_get_file_size,
 	.get_file_name = tar_get_file_name,
 	.write = tar_write,
+	.write_zeros = tar_write_zeros,
